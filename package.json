{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "dev:server": "node --experimental-strip-types --disable-warning=ExperimentalWarning --watch server/main.ts",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test server/test/*.test.ts 'dog race/server/'*.test.ts",
    "backup": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/backup-cli.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}